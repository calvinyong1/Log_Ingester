# Copy to .env and fill in real values. .env is gitignored.
# Generate a key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me

# Production (docker-compose.prod.yml) only
# DOMAIN=logs.example.com
# POSTGRES_PASSWORD=   # URL-safe, e.g. the same token_urlsafe command as above
# ALERT_WEBHOOK_URL=

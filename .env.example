# Copy to .env and fill in real values. .env is gitignored.
# Generate a key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me

# Optional, read by both compose files: where alerts are POSTed (a Discord
# webhook URL works). Treat it as a secret: anyone with it can post to the channel.
# ALERT_WEBHOOK_URL=

# Optional: log output format for the API and worker. text (readable) is the
# dev compose default; json is for log tools and is what the prod file uses.
# LOG_FORMAT=json

# Production (docker-compose.prod.yml) only
# DOMAIN=logs.example.com
# POSTGRES_PASSWORD=   # URL-safe, e.g. the same token_urlsafe command as above

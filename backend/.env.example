# Async Postgres URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/logs
# RDS: append ?ssl=require to encrypt the connection (asyncpg's spelling; psycopg's
# sslmode= is not understood). "require" does not verify the server certificate.

# Redis, shared by the API (queue producer) and worker (queue consumer)
REDIS_URL=redis://redis:6379/0
# ElastiCache with in-transit encryption enabled needs the rediss:// scheme.

# App
ENV=development
LOG_LEVEL=INFO
# json: one JSON object per line, for log tools. text: readable, for local use.
LOG_FORMAT=json
CORS_ORIGINS=http://localhost:5173

# Anomaly detection thresholds, read by the worker
ERROR_RATE_WINDOW_SECONDS=300
ERROR_RATE_THRESHOLD=0.5
ERROR_RATE_MIN_EVENTS=5
ALERT_COOLDOWN_SECONDS=300
# The URL receives JSON with a Discord-compatible `content` field plus
# alert_id, fired_at, service, total, errors and error_rate.
# ALERT_WEBHOOK_URL=https://example.com/webhook
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_TIMEOUT_SECONDS=5

# Ingest: retries for a failed worker job, and its time limit
JOB_MAX_RETRIES=3
JOB_TIMEOUT_SECONDS=60
# Producer timestamps outside this range are rejected with 422
TIMESTAMP_MAX_FUTURE_SECONDS=300
TIMESTAMP_MAX_AGE_DAYS=30

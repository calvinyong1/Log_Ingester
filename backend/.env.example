# Async Postgres URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/logs

# Redis, shared by the API (queue producer) and worker (queue consumer)
REDIS_URL=redis://redis:6379/0

# App
ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Anomaly detection thresholds, read by the worker
ERROR_RATE_WINDOW_SECONDS=300
ERROR_RATE_THRESHOLD=0.5
ERROR_RATE_MIN_EVENTS=5
ALERT_COOLDOWN_SECONDS=300
# ALERT_WEBHOOK_URL=https://example.com/webhook
